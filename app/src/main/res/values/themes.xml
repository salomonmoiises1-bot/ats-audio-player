<resources>
    <style name="Theme.ATSAudioPlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="colorSecondary">@color/purple_accent</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
    </style>

    <style name="ThemeOverlay.SearchView" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColorHint">#808080</item>
        <item name="android:editTextColor">#FFFFFF</item>
